{
  "name": "devos-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Secure Electron shell for DevOS Web.",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "electron .",
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit",
    "package": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "build": {
    "appId": "com.devos.desktop",
    "productName": "DevOS Desktop",
    "files": ["dist/**", "package.json"],
    "win": { "target": "nsis" }
  }
}
